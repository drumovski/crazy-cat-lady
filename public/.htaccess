# Long-lived caching for static game assets (card art, sound effects,
# background music, fonts) served from cards/, sounds/, music/, fonts/.
#
# Mirrors vite.config.js's longLivedStaticAssetCache plugin, which only
# patches Vite's own dev/preview servers -- it has no effect once dist/
# is just a folder served by SiteGround's Apache, which is what actually
# serves this in production. Without this, Apache's default headers can
# force revalidation on every request, which is what originally caused
# a Firefox-only bug where card images intermittently hung mid-game
# (see CLAUDE.md's "Illustrated-card alt-text flash" section).
#
# None of these files are ever replaced in place -- a content change
# always means a new filename (see CLAUDE.md's UI/design notes on cat
# art and Ginger Tom variants) -- so there's no correctness reason to
# ever revalidate them once fetched.

<IfModule mod_headers.c>
  <FilesMatch "\.(png|webp|mp3|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
